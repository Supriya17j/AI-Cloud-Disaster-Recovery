# Copy to .env. App works without any AWS values (local mode).
STORAGE_MODE=local        # local | cloud
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
DYNAMODB_ENABLED=false
AWS_DYNAMODB_TABLE=RecoveryEvents
AWS_DYNAMODB_ENDPOINT_URL=
RTO_TARGET_S=300
RPO_TARGET_MIN=240
WEATHER_API_KEY=
WEATHER_LOCATION=local
CYBER_CSV_PATH=
DEMO_MODE=false
DEMO_CYBER_CSV_PATH=data/demo/ransomware_attack.csv
DEMO_RISK_ALARM_THRESHOLD=35
CLOUDWATCH_ENABLED=false
CLOUDWATCH_NETWORK_OUT_METRIC=NetworkOut
CLOUDWATCH_NAMESPACE=AWS/EC2
CLOUDWATCH_DIMENSION_NAME=InstanceId
CLOUDWATCH_DIMENSION_VALUE=i-07891636d253b0d23
CLOUDWATCH_CPU_METRIC=CPUUtilization
CLOUDWATCH_MEMORY_METRIC=MemoryUtilization
CLOUDWATCH_DISK_METRIC=Disk_usage_percent
CLOUDWATCH_NETWORK_METRIC=NetworkIn
CLOUDWATCH_HEALTH_METRIC=status_check_failed
CLOUDWATCH_STATUS_CHECK_METRIC=StatusCheckFailed
CLOUDWATCH_ALARM_NAMES=dr_cpu_anomaly_alerts
CLOUDWATCH_PERIOD_S=60
CLOUDWATCH_LOOKBACK_MIN=10
AWS_CLOUDWATCH_ENDPOINT_URL=
